# Copy to glance.env and edit, then: launchctl kickstart -k gui/$(id -u)/com.example.glance.server
#
# Point at a calendar. A private .ics subscription URL from Google/Outlook/iCloud
# avoids the Full Disk Access and TCC prompts that reading ~/Library/Calendars needs.
# export GLANCE_ICS="https://calendar.google.com/calendar/ical/..../basic.ics"
# export GLANCE_ICS="/path/to/calendar.ics"

# Log every hook received. Off by default - it writes session ids and tool names
# to logs/server.log.
# export DEBUG=1

# Weather for the window scene. Lat,lon of the desk. Fetched server-side from
# Open-Meteo (no API key). Leave unset and the payload's weather field is null.
# export GLANCE_LATLON="51.48,0.00"

# Calendars. Any number of named sources are merged; the label becomes
# meeting.source so the display can distinguish them. webcal:// is fine.
# export GLANCE_ICS_FAMILY="webcal://p12-caldav.icloud.com/published/2/YOUR-TOKEN"
# export GLANCE_ICS_WORK="https://outlook.office365.com/owa/calendar/.../calendar.ics"

# Per-source meeting lead times, "headsup,soon,now" in minutes (default 10,5,2).
# Source changes WHEN the ladder fires, never how loud it is.
# export GLANCE_LEAD_FAMILY="20,10,5"

# Work calendar via macOS Calendar.app, for accounts that cannot publish an .ics
# (New Outlook exposes no calendar AppleScript; the local store needs Full Disk
# Access). Value is a calendar index or name — check logs/server.log for the
# "mac calendar resolved" line, since indexes shift if you add/remove accounts.
# One read is ~45s of Calendar.app work, so it polls every 15min by default.
# export GLANCE_MACCAL="4"
# export GLANCE_MACCAL_LABEL="work"
# export GLANCE_MACCAL_POLL_MS="900000"

# Which character stands on the desk. Omit for the client's default (you-a).
# export GLANCE_MASCOT="you-b"

# Show the panel on the primary display when the 1280x720 one is absent.
# Off by default so a panel switched off at night does not put a window on the
# main screen. Useful when developing without the dock attached.
# export GLANCE_DEV=1

# Which calendar source goes UNMARKED in peek (the high-volume one).
# Defaults to GLANCE_MACCAL_LABEL. Unset entirely = no source tags at all.
# export GLANCE_DEFAULT_SOURCE="work"

# How long peek stays up: BASE + ROW per row, capped at MAX (all milliseconds).
# Defaults 2000 / 1000 / 8000 — CD's formula. Six rows currently gives exactly 8s.
# For a longer read, raise BASE and MAX together, e.g. 3000 / 1500 / 15000 = 12s.
# export GLANCE_PEEK_BASE_MS="3000"
# export GLANCE_PEEK_ROW_MS="1500"
# export GLANCE_PEEK_MAX_MS="15000"

# Read macOS Calendar's local store directly (~/Library/Calendars). These are
# real .ics files with RRULE, so recurring meetings expand correctly — which
# AppleScript cannot do. Requires Full Disk Access; silently does nothing
# without it. Supersedes GLANCE_MACCAL once working.
# export GLANCE_LOCALCAL="1"
# export GLANCE_LOCALCAL_EXCLUDE="birthdays,siri suggestions,us holidays"

# The display to claim, in points. Must match the panel you want it on — the
# wrapper finds the display by size. Defaults to 1280x720.
# export GLANCE_PANEL_W="1024"
# export GLANCE_PANEL_H="600"
